# LLM provider: "ollama" | "openrouter"
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter settings (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/tender_finder.db
UPLOAD_DIR=./data/uploads

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Search
SEARCH_PROVIDER=duckduckgo
MAX_SEARCH_RESULTS=8
REQUEST_TIMEOUT_SECONDS=15
SEARCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
